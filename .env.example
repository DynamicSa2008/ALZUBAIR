# Copy to .env for local builds. Nothing here is secret: Vite bakes VITE_* values into the public JS.
# Server secrets (database, dashboard password) live in public/api/config.php on the server instead.

# Public address of the site (no trailing slash) and the path it is served from.
VITE_SITE_URL=https://trademarks-sa.com
VITE_BASE=/

# Optional for `npm run dev`: point the local site at the live API to work with real data.
# (The API must list http://localhost:5173 in allowed_origins in config.php.)
# VITE_API_URL=https://trademarks-sa.com/api/

# Local development only (no PHP): dashboard password.
VITE_DASHBOARD_PIN=2030

# Optional: forward WhatsApp messages through your own WhatsApp Cloud API endpoint.
# VITE_WHATSAPP_API_URL=
