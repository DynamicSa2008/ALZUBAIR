# Copy this file to .env.local and fill in what you need.
# Vite inlines VITE_* variables at BUILD time, so rebuild/redeploy after changing them.
# Every value is optional: without the integrations, forms fall back to opening
# WhatsApp (wa.me) with a prefilled message for the visitor to send.
# Never put secrets here that must stay private — VITE_* values end up in the public bundle.

# Your own HTTPS endpoint that forwards messages to the WhatsApp Cloud API.
# It receives POST JSON { to, message, subject } and should keep the Meta access token server-side.
VITE_WHATSAPP_API_URL=

# EmailJS (https://www.emailjs.com) — sends an email to the company on every submission.
# The template can use: {{subject}}, {{message}}, {{reply_to}}, {{to_email}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# PIN for /dashboard (defaults to 2030 when empty). A convenience lock, not real security.
VITE_DASHBOARD_PIN=
